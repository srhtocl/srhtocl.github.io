rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Yardımcı Fonksiyonlar ---

    // Admin kontrolü: auth null değilse ve token içinde admin=true claim'i varsa
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Tek bir mesajın şeklini ve gönderenini doğrular.
    // Ziyaretçi yalnızca kendi adına (user == chatId) yazabilir; "admin" olarak
    // işaretlenmiş mesajı ise sadece gerçekten kimliği doğrulanmış admin yazabilir.
    function isValidMessage(msg, chatId) {
      return msg is map
          && msg.keys().hasOnly(['user', 'time', 'data'])
          && msg.keys().hasAll(['user', 'time', 'data'])
          && msg.time is int
          && msg.data is string
          && msg.data.size() > 0
          && msg.data.size() <= 2000
          && (msg.user == chatId || (msg.user == 'admin' && isAdmin()));
    }

    // Mesaj dizisinin yalnızca sonuna TEK bir mesaj eklendiğini doğrular.
    // Önceki mesajlar birebir korunmalı: araya sahte (ör. "admin") mesaj
    // sokmak, geçmişi silmek veya değiştirmek bu sayede engellenir.
    function isSingleAppend(chatId) {
      let before = resource.data.get('messages', []);
      let after = request.resource.data.messages;
      return after is list
          && after.size() == before.size() + 1
          && after.size() <= 200
          && after[0:before.size()] == before
          && isValidMessage(after[after.size() - 1], chatId);
    }

    // Mesajlar (chats)
    // Anonim kullanıcılar Firebase Auth kullanmadığı için request.auth null olur.
    // Doküman ID'si ziyaretçinin çerezindeki rastgele kimlikle birebir aynıdır
    // (bkz. useChat.js); ziyaretçi kendi sohbetini TEK doküman okuyarak (get) bulur.
    // Kimliği bilmek = o sohbetin sahibi olmak, bu yüzden kimlik tahmin edilemez üretilir.
    // get   : Herkese açık (ziyaretçi kendi ID'sini biliyorsa kendi sohbetini görebilir)
    // list  : Sadece Admin (aksi halde herkes TÜM ziyaretçilerin mesajlarını tek sorguda çekebilirdi)
    // create: Yalnızca rastgele biçimli ID (32 hex), boş mesaj dizisi ve chatId == user ile.
    // update: Admin her şeyi; ziyaretçi ya sona tek mesaj ekler ya da bildirim tokenını günceller.
    // delete: Sadece Admin
    match /chats/{chatId} {
      allow get: if true;
      allow list: if isAdmin();

      allow create: if chatId.matches('^[0-9a-f]{32}$')
                   && request.resource.data.keys().hasOnly(['user', 'messages'])
                   && request.resource.data.user is string
                   && request.resource.data.user.size() > 0
                   && request.resource.data.user.size() <= 100
                   && request.resource.data.user == chatId
                   && request.resource.data.messages is list
                   && request.resource.data.messages.size() == 0;

      allow update: if isAdmin()
                   || (
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages'])
                     && isSingleAppend(chatId)
                   )
                   || (
                     request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['fcmToken', 'tokenUpdatedAt'])
                     && request.resource.data.get('fcmToken', '') is string
                     && request.resource.data.get('fcmToken', '').size() <= 4096
                   );

      allow delete: if isAdmin();
    }

    // 1. Admin Profil Bilgileri (Herkes görebilir, sadece Admin değiştirebilir)
    match /admin/profile {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Admin Bildirim Tokenı (Sadece Admin okuyabilir ve yazabilir)
    match /admin/notifications {
      allow read, write: if isAdmin();
    }

    // Blog (post) tamamen ÖZEL
    match /post/{document=**} {
      allow read, write: if isAdmin();
    }

    // Kategoriler (categories) tamamen ÖZEL (Sadece Admin)
    match /categories/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
