rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Yardımcı Fonksiyonlar ---

    // Admin kontrolü: auth null değilse ve token içinde admin=true claim'i varsa
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Yeni mesajın içeriğinin geçerli olup olmadığını kontrol eder
    function isValidMessage(msg) {
      return msg.keys().hasAll(['user', 'time', 'data'])
          && msg.data is string
          && msg.data.size() > 0
          && msg.data.size() <= 2000;
    }

    // messages array boyutunun sınır içinde olup olmadığını kontrol eder
    function hasValidMessageCount(data) {
      return !(data.keys().hasAny(['messages']))
          || data.messages.size() <= 200;
    }

    // Mesajlar (chats)
    // Anonim kullanıcılar Firebase Auth kullanmadığı için request.auth null olur.
    // Doküman ID'si artık ziyaretçinin çerez değeriyle birebir aynı (bkz. useChat.js),
    // bu sayede ziyaretçi kendi sohbetini her zaman TEK doküman okuyarak (get) bulur,
    // koleksiyonun tamamını sorgulamasına (list) hiç gerek kalmaz.
    // get   : Herkese açık (ziyaretçi kendi ID'sini biliyorsa kendi sohbetini görebilir)
    // list  : Sadece Admin (aksi halde herkes TÜM ziyaretçilerin mesajlarını tek sorguda çekebilirdi)
    // create: Yalnızca boş mesaj dizisiyle ve chatId == user alanıyla belge oluşturulabilir.
    // update: Mesaj sayısı ve uzunluk sınırı kontrol edilir
    // delete: Sadece Admin
    match /chats/{chatId} {
      allow get: if true;
      allow list: if isAdmin();

      allow create: if request.resource.data.keys().hasAll(['user', 'messages'])
                   && request.resource.data.user is string
                   && request.resource.data.user.size() > 0
                   && request.resource.data.user.size() <= 100
                   && request.resource.data.user == chatId
                   && request.resource.data.messages is list
                   && request.resource.data.messages.size() == 0;

      allow update: if hasValidMessageCount(request.resource.data)
                   && (
                     !request.resource.data.keys().hasAny(['messages'])
                     || request.resource.data.messages.size() == 0
                     || isValidMessage(
                          request.resource.data.messages[
                            request.resource.data.messages.size() - 1
                          ]
                        )
                   );

      allow delete: if isAdmin();
    }

    // 1. Admin Profil Bilgileri (Herkes görebilir, sadece Admin değiştirebilir)
    match /admin/profile {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Admin Bildirim Tokenı (Sadece Admin okuyabilir ve yazabilir)
    match /admin/notifications {
      allow read, write: if isAdmin();
    }

    // Blog (post) tamamen ÖZEL
    match /post/{document=**} {
      allow read, write: if isAdmin();
    }

    // Kategoriler (categories) tamamen ÖZEL (Sadece Admin)
    match /categories/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
